# CodeArena environment example — copy to .env

# --- Postgres（本机库名 codearena；用户默认 codearena）---
POSTGRES_USER=codearena
POSTGRES_PASSWORD=zephyr
POSTGRES_DB=codearena
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DSN=postgresql://codearena:zephyr@127.0.0.1:5432/codearena

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0

# --- Nacos ---
NACOS_HOST=127.0.0.1
NACOS_PORT=8848
NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_NAMESPACE=public
NACOS_USERNAME=
NACOS_PASSWORD=

# --- LLM service ---
LLM_SERVICE_PORT=8091
LLM_PROVIDER=mock
LLM_BASE_URL=http://127.0.0.1:11434
LLM_API_KEY=
LLM_COACH_MODEL=qwen2.5:7b-instruct-q4_K_M
LLM_TIMEOUT_SECONDS=60
# 编排器回调执行官（compose 内用服务名；本机直连用 127.0.0.1:8090）
BUSINESS_INTERNAL_URL=http://127.0.0.1:8090
INTERNAL_TOOL_TOKEN=codearena-internal-dev
# LangGraph checkpoint：auto（有 Redis 用 Redis）| redis | memory
CHECKPOINT_BACKEND=auto
CHECKPOINT_TTL_SECONDS=604800

# --- App ports ---
HTTP_PORT=80
GATEWAY_PORT=8080
BUSINESS_SERVICE_PORT=8090

# business-service 与 llm-service 共享内网 Token
CODEARENA_INTERNAL_TOKEN=codearena-internal-dev
# 可选：AES 加密用户 api_key（生产建议设置）
# CODEARENA_LLM_KEY_SECRET=change-me-to-a-long-secret

# Optional image overrides when Java services are published
# GATEWAY_IMAGE=codearena/gateway:latest
# BUSINESS_IMAGE=codearena/business-service:latest

# --- Observability ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
LOKI_PORT=3100
SKYWALKING_GRPC_PORT=11800
SKYWALKING_HTTP_PORT=12800
SKYWALKING_UI_PORT=8088
