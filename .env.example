# CodeArena environment example — copy to .env

# --- Postgres（本机库名 codearena；用户默认 codearena）---
POSTGRES_USER=codearena
POSTGRES_PASSWORD=zephyr
POSTGRES_DB=codearena
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DSN=postgresql://codearena:zephyr@127.0.0.1:5432/codearena

# --- Redis（本机 redis-stack 默认 6380，避免与 brew redis :6379 冲突）---
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_URL=redis://127.0.0.1:6380/0
# business 用户维 stats 缓存（local profile 默认关；compose/有 Redis 时开）
# CODEARENA_CACHE_REDIS_ENABLED=true
# CODEARENA_CACHE_STATS_ENABLED=true
# CODEARENA_CACHE_STATS_TTL_SECONDS=3600
# 可选：仅 stack 脚本用，不设则跟 REDIS_PORT
# REDIS_STACK_PORT=6380

# --- Qdrant（用户知识库向量索引）---
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
CODEARENA_KNOWLEDGE_ENABLED=true
CODEARENA_QDRANT_URL=http://127.0.0.1:6333
CODEARENA_QDRANT_COLLECTION=leetmate_user_kb
CODEARENA_EMBEDDING_PROVIDER=mock
CODEARENA_EMBEDDING_DIM=384
CODEARENA_EMBEDDING_MODEL=mock-hash-v1
CODEARENA_EMBEDDING_VERSION=1
# 火山 Ark vision embedding（OpenAI 文本 /embeddings 需另开通；vision 走 multimodal）:
# CODEARENA_EMBEDDING_PROVIDER=http
# CODEARENA_EMBEDDING_DIM=2048
# CODEARENA_EMBEDDING_MODEL=doubao-embedding-vision-251215
# CODEARENA_EMBEDDING_VERSION=3
# CODEARENA_EMBEDDING_HTTP_URL=https://ark.cn-beijing.volces.com/api/v3/embeddings/multimodal
# CODEARENA_EMBEDDING_HTTP_API_KEY=ark-xxxx
# OpenAI 兼容文本 embedding:
# CODEARENA_EMBEDDING_HTTP_URL=http://127.0.0.1:8080/v1/embeddings
# CODEARENA_KNOWLEDGE_STORAGE_DIR=./data/knowledge
# CODEARENA_KNOWLEDGE_LLM_CLEAN=false
# CODEARENA_KNOWLEDGE_LLM_REFINE=false
# CODEARENA_KNOWLEDGE_LLM_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions
# CODEARENA_KNOWLEDGE_LLM_API_KEY=ark-xxxx
# CODEARENA_KNOWLEDGE_LLM_MODEL=your-chat-model
# CODEARENA_KNOWLEDGE_MAX_KPS=200
# CODEARENA_KNOWLEDGE_MAX_RAW_CHARS=200000
# CODEARENA_KNOWLEDGE_MAX_UPLOAD_MB=80

# --- LLM service ---
# 本机 make llm 监听端口；docker compose 默认不把 llm 映射到宿主机
LLM_SERVICE_PORT=8091
LLM_PROVIDER=api
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_COACH_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=60
# 编排器 gRPC 回调执行官（compose 内用服务名；本机直连用 127.0.0.1:9092）
BUSINESS_GRPC_TARGET=127.0.0.1:9092
LLM_GRPC_HOST=127.0.0.1
LLM_GRPC_PORT=9093
INTERNAL_TOOL_TOKEN=codearena-internal-dev
# LangGraph checkpoint：auto（探测 JSON.SET）| redis | memory
# 需 redis-stack（本机 brew cask redis-stack-server，或 compose 中 redis/redis-stack-server）
CHECKPOINT_BACKEND=auto
CHECKPOINT_TTL_SECONDS=604800

# --- App ports ---
HTTP_PORT=80
GATEWAY_PORT=8080
# 本机 make business 端口；docker compose 默认不映射 business/llm 到宿主机（经 Gateway 访问）
BUSINESS_SERVICE_PORT=8090

# business-service 与 llm-service 共享内网 Token
CODEARENA_INTERNAL_TOKEN=codearena-internal-dev
# JWT：Gateway 与 business 必须相同（生产务必更换；profile=prod 时拒绝默认值）
CODEARENA_JWT_SECRET=codearena-dev-jwt-secret-change-me-32b
CODEARENA_JWT_ISSUER=codearena
# 生产 profile 下默认强制强密钥；应急可 false
# CODEARENA_STRICT_SECRETS=true
# Gateway Redis 共享限流（认证用户优先，匿名 IP 兜底）
# CODEARENA_RATE_LIMIT_ENABLED=true
# CODEARENA_RATE_LIMIT_DEFAULT=60
# CODEARENA_RATE_LIMIT_STREAM=20
# CODEARENA_RATE_LIMIT_SUBMIT=20
# CODEARENA_RATE_LIMIT_AUTH=10
# CODEARENA_RATE_LIMIT_EXPORT=5
# AES-GCM 加密用户 api_key（生产 profile 必填，至少 32 字符）
# CODEARENA_LLM_KEY_SECRET=change-me-to-a-long-secret

# Optional image overrides when Java services are published
# GATEWAY_IMAGE=codearena/gateway:latest
# BUSINESS_IMAGE=codearena/business-service:latest

# --- Observability ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
LOKI_PORT=3100
# SQL 日志：DEBUG 看 Hibernate SQL；TRACE 看 bind（勿在生产开 bind）
CODEARENA_SQL_LOG_LEVEL=INFO
CODEARENA_SQL_BIND_LEVEL=WARN
CODEARENA_MAIL_ENABLED=false
CODEARENA_SMTP_HOST=
CODEARENA_SMTP_PORT=587
CODEARENA_SMTP_USERNAME=
CODEARENA_SMTP_PASSWORD=
CODEARENA_MAIL_FROM=no-reply@codearena.local
# 本地/Docker Desktop 默认 subprocess；Linux 生产在确认 user namespace 可用后改 bwrap
SANDBOX_BACKEND=subprocess
SANDBOX_TIMEOUT_S=10
SANDBOX_MEMORY_MB=256
SANDBOX_MAX_RUNS_PER_MINUTE=10
