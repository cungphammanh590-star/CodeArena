{
  "manifest_version": 3,
  "name": "CodeArena Tracker",
  "version": "0.5.0",
  "description": "登录 CodeArena 后，将 leetcode.cn 提交同步到你的账号并打开陪练。",
  "permissions": ["storage", "alarms", "notifications", "tabs", "activeTab"],
  "host_permissions": [
    "https://leetcode.cn/*",
    "http://127.0.0.1:8080/*",
    "http://localhost:8080/*",
    "http://127.0.0.1:5173/*",
    "http://localhost:5173/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://leetcode.cn/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://leetcode.cn/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://127.0.0.1:5173/*",
        "http://localhost:5173/*"
      ],
      "js": ["web-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["https://leetcode.cn/*"]
    }
  ],
  "action": {
    "default_title": "CodeArena",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
